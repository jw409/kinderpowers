  "version": "7.4.0",
  "author": {
    "name": "jw409"
  },
  "homepage": "https://github.com/jw409/kinderpowers",
  "repository": "https://github.com/jw409/kinderpowers",
  "license": "MIT",
  "keywords": [
    "mcp-servers",
    "github",
    "stepwise-planning",
    "token-compression",
    "agency-preserving"
  ],
  "mcpServers": {
    "kp-github": {
      "command": "${CLAUDE_PLUGIN_ROOT}/mcp-servers/bin/kp-github-mcp",
      "args": [],
