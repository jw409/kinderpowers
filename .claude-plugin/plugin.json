    "kp-stepwise": {
      "command": "${CLAUDE_PLUGIN_ROOT}/mcp-servers/bin/kp-stepwise",
      "args": [],
      "env": {
        "STEPWISE_MODEL": "claude-opus-4-7",
        "KP_STEPWISE_LOG_LEVEL": "warn"
      }
    }
  }
